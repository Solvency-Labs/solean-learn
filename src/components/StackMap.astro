---
// The one diagram that orients a new teammate: how the pieces relate.
// Each layer links into the track that teaches it.
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/([^:]\/)\/+/g, '$1');

const layers = [
	{
		title: 'AA smart wallet',
		sub: 'validates a UserOp: entry-point · nonce · domain · replay · execution gating',
		tag: 'SoLean-style proofs',
		link: 'aa-pq/',
		cls: '',
		edge: '│  calls  ▼',
	},
	{
		title: 'FORS verifier — recover(bytes sig, bytes32 digest) → address',
		sub: 'the post-quantum signature check. THIS is the contract we must verify.',
		tag: 'THE TASK',
		link: 'fors/the-contract/',
		cls: 'stackmap__layer--task',
		edge: '│  uses  ▼',
	},
	{
		title: 'keccak-256',
		sub: 'the only hash primitive FORS needs',
		tag: 'TRUSTED — not re-proven',
		link: 'task/',
		cls: 'stackmap__layer--trusted',
		edge: '▲  everything above is modeled & proven in  ▲',
	},
	{
		title: 'Lean 4  ·  verity (Lean → Yul)  ·  EVMYulLean (EVM/Yul semantics)',
		sub: 'the proof assistant and the two toolchains we build on',
		tag: 'T4 – T5',
		link: 'tooling/',
		cls: '',
		edge: '',
	},
];
---

<div class="stackmap" role="list">
	{
		layers.map((l) => (
			<>
				<a class={`stackmap__layer ${l.cls}`} href={href(l.link)} role="listitem">
					<span class="stackmap__tag">{l.tag}</span>
					<span class="stackmap__title">{l.title}</span>
					<span class="stackmap__sub">{l.sub}</span>
				</a>
				{l.edge && <div class="stackmap__edge">{l.edge}</div>}
			</>
		))
	}
</div>
